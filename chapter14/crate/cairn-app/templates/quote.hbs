<!doctype html>
<html><head><meta charset="utf-8"><title>Quote {{number}}</title>
<link rel="stylesheet" href="report.css"></head>
<body>
<div class="letterhead">
  <div><img src="logo.svg"><h1>QUOTE</h1></div>
  <div class="co"><b>{{company.name}}</b>
    {{#each company.address}}<br>{{this}}{{/each}}
    <br>{{company.contact}}</div>
</div>
<table class="meta">
  <tr><td class="k">Quote #</td><td>{{number}}</td>
      <td class="k">Date</td><td>{{date}}</td></tr>
  <tr><td class="k">Sales rep</td><td>{{rep}}</td>
      <td class="k">Valid until</td><td>{{valid_until}}</td></tr>
</table>
<div class="addresses"><div><h2>Prepared for</h2>
  {{#each bill_to}}{{this}}<br>{{/each}}</div></div>
<table class="rows">
  <thead><tr><th>#</th><th>SKU</th><th>Description</th>
    <th class="r">Qty</th><th class="r">Unit price</th>
    <th class="r">Disc.</th><th class="r">Amount</th></tr></thead>
  <tbody>
  {{#each lines}}
  <tr><td>{{n}}</td><td>{{sku}}</td><td>{{description}}</td>
    <td class="r">{{quantity}}</td><td class="r">{{unit_price}}</td>
    <td class="r">{{discount}}</td><td class="r">{{total}}</td></tr>
  {{/each}}
  </tbody>
</table>
<table class="totals">
  <tr><td>Subtotal</td><td class="r">{{subtotal}}</td></tr>
  <tr><td>Tax ({{tax_rate}})</td><td class="r">{{tax}}</td></tr>
  <tr><td>Shipping</td><td class="r">{{shipping}}</td></tr>
  <tr class="grand"><td>Quote total</td>
      <td class="r">{{total}}</td></tr>
</table>
{{#if notes}}<p class="notes">{{notes}}</p>{{/if}}
<p class="terms"><b>Terms.</b> {{terms}}</p>
</body></html>
