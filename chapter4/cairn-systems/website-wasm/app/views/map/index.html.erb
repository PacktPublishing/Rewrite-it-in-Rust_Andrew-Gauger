<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<% end %>

<header class="site-header">
  <h1>Fleet Monitor</h1>

  <nav class="scenario-picker">
    <%= link_to "Agricultural sensors (cluster)", root_path(scenario: "cluster", engine: @engine),
          class: @scenario == "cluster" ? "active" : "", data: { turbo: false } %>
    <%= link_to "Container fleet (highway)", root_path(scenario: "highway", engine: @engine),
          class: @scenario == "highway" ? "active" : "", data: { turbo: false } %>
  </nav>

  <nav class="engine-picker">
    <span>Engine:</span>
    <%= link_to "Legacy (JS)", root_path(scenario: @scenario, engine: "legacy"),
          class: @engine == "legacy" ? "active" : "", data: { turbo: false } %>
    <%= link_to "WASM (Rust)", root_path(scenario: @scenario, engine: "wasm"),
          class: @engine == "wasm" ? "active" : "", data: { turbo: false } %>
  </nav>

  <p class="reading-count" id="reading-count-text">Loading readings&hellip;</p>

  <div class="view-mode">
    <label><input type="radio" name="view-mode" value="all" checked> Show all readings</label>
    <label><input type="radio" name="view-mode" value="playback"> Time playback</label>
  </div>

  <div class="playback-controls" hidden>
    <button type="button" id="play-pause">Play</button>
    <input type="range" id="time-slider" min="0" max="0" value="0" step="1">
    <span id="time-label"></span>
  </div>

  <div class="sensor-picker" id="sensor-picker" hidden></div>

  <p class="perf-readout" id="perf-readout" hidden></p>
</header>

<div id="map" data-scenario="<%= @scenario %>"></div>

<% if @engine == "wasm" %>
  <script type="module">import "wasm_engine";</script>
<% else %>
  <script type="module">import "legacy_engine";</script>
<% end %>
